# =====================================================================
# CONFIGURAZIONE CENTRALE - copia questo file in ".env" e compila i valori
# Il file .env NON deve MAI essere committato (vedi .gitignore)
# =====================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-inserisci-qui-la-tua-chiave
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Backend Node.js (orchestratore) ---
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# --- ChromaDB (server locale) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=belmoro_hr_policies

# --- Microservizio Python (data agent) ---
DATA_AGENT_URL=http://localhost:8000
DATA_AGENT_PORT=8000
# Budget di tempo del data agent (analisi + eventuale secondo passaggio sul grafico)
BUDGET_ANALISI_S=150
BUDGET_GRAFICO_S=45
# Timeout del chiamante: deve restare MAGGIORE della somma dei due budget
DATA_AGENT_TIMEOUT_MS=260000
# Oltre questa soglia il dataset non viene caricato in memoria: campione + SQL
MAX_RIGHE_IN_MEMORIA=200000

# --- Redis (opzionale) ---
# Senza questa variabile cache e sessioni restano nella memoria del processo:
# va bene con una sola istanza. Valorizzandola, le stesse informazioni sono
# condivise fra tutte le repliche del backend e sopravvivono ai riavvii.
REDIS_URL=redis://localhost:6379

# --- Cache delle risposte ---
CACHE_RISPOSTE=on
CACHE_TTL_RAG_MINUTI=60
CACHE_TTL_DATI_MINUTI=30

# --- Manutenzione dei grafici ---
CHARTS_TTL_ORE=24
CHARTS_PULIZIA_MINUTI=60

# --- Percorsi condivisi (relativi alla root del progetto) ---
CSV_PATH=./data/hr_dipendenti_belmoro.csv
KB_PATH=./data/hr_policy_belmoro.txt
CHARTS_DIR=./shared/charts
DUCKDB_PATH=./shared/hr_dataset.duckdb
